# GovFlow KSA — Case Officer service
# Copy to .env and fill in real values. NEVER commit .env.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=govflow-ksa

# Self-generated secret for the MCP-auth-gated mock Balady submission tool.
# Generate with: openssl rand -hex 32
MCP_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# Optional. Defaults to <repo>/data/gov_corpus; set only if you move the corpus
# or run in a container with a different mount point.
# GOV_CORPUS_DIR=/app/data/gov_corpus
