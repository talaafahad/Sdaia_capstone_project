# GovFlow KSA — Municipal & Location A2A microservice
# Copy to .env and fill in real values. NEVER commit .env.
#
# This service deliberately does NOT receive the LangSmith or MCP_AUTH_SECRET
# values used by case-officer — per-service .env files keep secrets scoped to
# the service that actually needs them.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Needed only because this service does its own balady.gov.sa retrieval
# (handoff doc section 3, per the implementation plan's agent split).
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
