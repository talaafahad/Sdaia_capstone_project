# --- Secrets (never commit) ---
# NOTE: .env.example files are intentionally NOT ignored — they are committed.
.env
.env.local
.env.*.local

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- Retrieval caches (regenerable; keep out of the repo) ---
data/.tavily_cache/
data/.embed_cache/

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*
data/.llm_cache/
